generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Song {
  id               String             @id @default(cuid())
  title            String
  artist           String
  album            String?
  genre            String?
  audioUrl         String?
  coverUrl         String?
  lyricsUrl        String?
  duration         Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  userId           String
  Favorite         Favorite[]
  ListeningHistory ListeningHistory[]
  PlaylistSong     PlaylistSong[]
  User             User               @relation(fields: [userId], references: [id])
}

model Album {
  id        String   @id
  title     String
  artist    String?
  coverUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Artist {
  id        String   @id
  name      String   @unique
  bio       String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Favorite {
  id        String   @id
  userId    String
  songId    String
  createdAt DateTime @default(now())
  Song      Song     @relation(fields: [songId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model Genre {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model ListeningHistory {
  id       String   @id
  userId   String
  songId   String
  playedAt DateTime @default(now())
  Song     Song     @relation(fields: [songId], references: [id])
  User     User     @relation(fields: [userId], references: [id])
}

model Lyrics {
  id        String   @id
  title     String
  content   String
  format    String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Playlist {
  id           String         @id
  title        String
  description  String?
  coverUrl     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  userId       String
  User         User           @relation(fields: [userId], references: [id])
  PlaylistSong PlaylistSong[]
}

model PlaylistSong {
  id         String   @id
  playlistId String
  songId     String
  order      Int
  Playlist   Playlist @relation(fields: [playlistId], references: [id])
  Song       Song     @relation(fields: [songId], references: [id])
}

model User {
  id               String             @id
  email            String             @unique
  name             String?
  image            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  Favorite         Favorite[]
  ListeningHistory ListeningHistory[]
  Playlist         Playlist[]
  Song             Song[]
}
