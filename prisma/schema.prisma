generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Song {
  id          String        @id @default(cuid())
  title       String
  artist      String
  album       String?
  genre       String?
  duration    Int?
  audio_path  String
  cover_path  String?
  lyrics_path String?
  created_at  DateTime      @default(now())
  playHistory PlayHistory[]
}

model PlayHistory {
  id                 String   @id @default(cuid())
  song               Song     @relation(fields: [song_id], references: [id])
  song_id            String
  played_at          DateTime @default(now())
  listening_duration Int
}

model Settings {
  id         String   @id @default(cuid())
  theme      String   @default("pixel-night")
  created_at DateTime @default(now())
}
